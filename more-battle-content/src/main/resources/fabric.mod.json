  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.11+kotlin.2.3.21",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": "1.7.3",
    "mega_showdown": ">=1.9.3+1.7.3+1.21.1"
  },
  "suggests": {
    "battlecam": "*"
