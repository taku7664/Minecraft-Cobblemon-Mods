# Gradle and Kotlin
.gradle/
.gradle-isolated/
.kotlin/
**/build/
build/
out/

# Local runtime downloads and deployment recovery copies are not source.
/versions/
/deployment-backups/

# Music pack archives are local build outputs.
cobleserver-music-resourcepack-*.zip

# Local Minecraft runtimes
run/
runs/
/develop-product/
# Release outputs: VERSION.txt and the requested production-server shortcut are tracked.
/deploy-product/**/*
!/deploy-product/*/
!/deploy-product/*/VERSION.txt
!/deploy-product/server/MineCraftPPakemonServer.lnk
/docs/
logs/
crash-reports/
saves/
world/
mods/
# `mods/` is meant for game folders; it must not swallow new sources under works/mods.
!works/mods/
config/
!works/mods/cobblemon-custom-species/src/main/kotlin/jbro/cobblemon/customspecies/config/
!works/mods/cobblemon-custom-species/src/main/kotlin/jbro/cobblemon/customspecies/config/**
!works/mods/cobblemon-custom-species/src/test/kotlin/jbro/cobblemon/customspecies/config/
!works/mods/cobblemon-custom-species/src/test/kotlin/jbro/cobblemon/customspecies/config/**
!works/mods/better-cobblemon-music/src/main/java/jbro/cobblemon/bettermusic/config/
!works/mods/better-cobblemon-music/src/main/java/jbro/cobblemon/bettermusic/config/**
!works/mods/better-cobblemon-music/src/test/java/jbro/cobblemon/bettermusic/config/
!works/mods/better-cobblemon-music/src/test/java/jbro/cobblemon/bettermusic/config/**
defaultconfigs/
resourcepacks/
# jbro-policy ships its built-in data packs from here.
!works/mods/jbro-policy/src/main/resources/resourcepacks/
!works/mods/jbro-policy/src/main/resources/resourcepacks/**
shaderpacks/
screenshots/
replay_recordings/
*.log
hs_err_pid*.log
replay_pid*.log

