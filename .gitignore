.env
.env.*
secrets/
*.secret
*.secrets
*.key
*.pem
local.properties
gradle-local.properties
gradle.properties.local
publish.properties
modrinth.token
curseforge.token

# Temporary working notes. Scratch documents for in-progress work, never published.
WIP-*.md
**/WIP-*.md

# Temporary agent and editor files
.codex-worktrees/
.codex-tmp/
.codex/
.claude/
.omc/
/work/
/local/
/tmp/
*.tmp
*.temp
*.bak
*.swp
*~

# Local Better Cobblemon Music hand-off audio. Keep copyrighted media out of Git.
works/mods/better-cobblemon-music/music-input/**/*.ogg
works/mods/better-cobblemon-music/music-input/**/*.mp3
works/mods/better-cobblemon-music/music-input/**/*.wav
works/mods/better-cobblemon-music/music-input/**/*.flac
works/mods/better-cobblemon-music/music-input/**/*.m4a
works/mods/better-cobblemon-music/music-input/**/*.aac

