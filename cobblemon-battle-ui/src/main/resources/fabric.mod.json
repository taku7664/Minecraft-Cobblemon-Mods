{
  "schemaVersion": 1,
  "id": "cobblemon_battle_ui",
  "version": "${version}",
  "name": "Cobblemon: Battle UI",
  "description": "A client-only replacement for Cobblemon's battle commands, information panels, logs, and team indicators.",
  "authors": ["jbro"],
  "contributors": ["sveniik (original Extended Battle UI)"],
  "contact": {
    "sources": "https://github.com/JBRO129/Minecraft-Cobblemon-Mods"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.battleui.extended.CobblemonExtendedBattleUIClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.battleui.extended.ModMenuIntegration"
      }
    ]
  },
  "mixins": [
    "cobblemon_battle_ui.mixins.json"
  ],
  "accessWidener": "cobblemon_battle_ui.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.12.0",
    "cobblemon": ">=1.8.1 <1.9.0"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
