{
  "schemaVersion": 1,
  "id": "more_cobblemon_contents",
  "version": "${version}",
  "name": "More Cobblemon Contents",
  "description": "Battle Tower, Battle Factory, PvP and League content for Cobblemon, with a built-in tactical AI.",
  "authors": ["jbro"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.mcc.MoreCobblemonContents"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.mcc.client.MoreCobblemonContentsClient"
      }
    ]
  },
  "mixins": [
    "more_cobblemon_contents.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0",
    "mega_showdown": "1.2.0+1.8.1+1.21.1-release"
  },
  "suggests": {
    "better_cobblemon_battlecam": "*"
  }
}
