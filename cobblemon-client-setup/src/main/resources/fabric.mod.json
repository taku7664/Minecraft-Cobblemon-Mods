{
  "schemaVersion": 1,
  "id": "cobblemon_client_setup",
  "version": "${version}",
  "name": "Cobblemon Client Setup",
  "description": "Applies client pack settings once or on every launch, before the game initializes.",
  "authors": ["jbro"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["jbro.cobblemon.clientsetup.ClientSetupPreLaunch"],
    "client": ["jbro.cobblemon.clientsetup.client.ClientSetupClient"],
    "modmenu": ["jbro.cobblemon.clientsetup.client.ClientSetupModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "cobbled_level_control": ">=1.2.0 <1.3.0",
    "modmenu": "*"
  }
}
