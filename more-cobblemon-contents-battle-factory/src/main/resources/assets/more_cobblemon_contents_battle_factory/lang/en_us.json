  "factory.more_cobblemon_contents.concept.arcanine_voltage.name": "Alex",
  "factory.more_cobblemon_contents.concept.arcanine_voltage.description": "Whimsicott and Raichu control speed and Electric pressure while Gastrodon absorbs Water and Ground attacks for Arcanine.",
  "factory.more_cobblemon_contents.concept.feraligatr_screen.name": "Maya",
  "factory.more_cobblemon_contents.concept.feraligatr_screen.description": "Klefki creates a Dragon Dance turn for Feraligatr while Roserade and Noivern cover its checks with special pressure.",
  "factory.more_cobblemon_contents.concept.heracross_rotation.name": "Ben",
  "factory.more_cobblemon_contents.concept.heracross_rotation.description": "Rotom-W creates safe entries, Mismagius adds special pressure, and Donphan supplies cleanup for Heracross.",
  "factory.more_cobblemon_contents.concept.porygon_balance.name": "Claire",
  "factory.more_cobblemon_contents.concept.porygon_balance.description": "Eviolite Porygon2 stabilizes the field with Thunder Wave while Staraptor, Chandelure, and Tsareena attack from distinct angles.",
  "factory.more_cobblemon_contents.concept.gyarados_screen.name": "Daniel",
  "factory.more_cobblemon_contents.concept.gyarados_screen.description": "Grimmsnarl sets screens, Magnezone handles Flying and Fairy pressure, and Mamoswine supplies priority for Gyarados.",
  "factory.more_cobblemon_contents.concept.volcarona_tailwind.name": "Alice",
  "factory.more_cobblemon_contents.concept.volcarona_tailwind.description": "Talonflame supplies Tailwind for Volcarona while Azumarill and Hydreigon divide Rock, Water, and Dragon matchups.",
  "factory.more_cobblemon_contents.concept.lucario_web.name": "Chris",
  "factory.more_cobblemon_contents.concept.lucario_web.description": "Ribombee lays Sticky Web for Lucario while Milotic and Krookodile cover Fire, Ghost, and Ground pressure.",
  "factory.more_cobblemon_contents.concept.dragonite_snow.name": "Julia",
  "factory.more_cobblemon_contents.concept.dragonite_snow.description": "Alolan Ninetales protects Dragonite with Aurora Veil while Metagross and Rotom-H cover Ice and Fairy attacks.",
  "factory.more_cobblemon_contents.concept.garchomp_followme.name": "Kevin",
  "factory.more_cobblemon_contents.concept.garchomp_followme.description": "Togekiss redirects attacks for Garchomp while Corviknight and Primarina cover Ice and Fairy pressure.",
  "factory.more_cobblemon_contents.concept.excadrill_sand.name": "Sarah",
  "factory.more_cobblemon_contents.concept.excadrill_sand.description": "Tyranitar activates Sand Rush for Excadrill while Amoonguss and Dragapult provide disruption and fast special pressure.",
  "factory.more_cobblemon_contents.concept.ceruledge_pivot.name": "Adam",
  "factory.more_cobblemon_contents.concept.ceruledge_pivot.description": "Rotom-W pivots Ceruledge into play while Meowscarada and Sylveon pressure Water, Dark, and Dragon checks.",
  "factory.more_cobblemon_contents.concept.samurott_rain.name": "Nina",
  "factory.more_cobblemon_contents.concept.samurott_rain.description": "Pelipper opens rain and Tailwind for Barraskewda while Rillaboom creates setup and priority-cleanup windows for Samurott.",
  "factory.more_cobblemon_contents.concept.salamence_pressure.name": "Eric",
  "factory.more_cobblemon_contents.concept.salamence_pressure.description": "Blaziken applies immediate physical pressure while Dondozo and Gholdengo cover opposite matchups and Salamence controls tempo with Tailwind.",
  "factory.more_cobblemon_contents.concept.empoleon_poison.name": "Laura",
  "factory.more_cobblemon_contents.concept.empoleon_poison.description": "Gliscor and Toxapex create durable poison pressure while Incineroar secures attack windows for Empoleon with Intimidate and Fake Out.",
  "factory.more_cobblemon_contents.concept.reuniclus_room.name": "James",
  "factory.more_cobblemon_contents.concept.reuniclus_room.description": "Reuniclus establishes Trick Room with Jellicent as a secondary setter while Haxorus and Mienshao divide slow and fast physical pressure.",
  "factory.more_cobblemon_contents.concept.kommoo_room.name": "Amy",
  "factory.more_cobblemon_contents.concept.kommoo_room.description": "Hatterene opens Trick Room for Kommo-o while Crobat and Scizor provide fast disruption, pivots, and priority cleanup.",
  "factory.more_cobblemon_contents.concept.metagross_disruption.name": "David",
  "factory.more_cobblemon_contents.concept.metagross_disruption.description": "Sableye creates an Agility window for Metagross with Taunt and Encore while Rotom-H and Hydreigon add special pressure.",
  "factory.more_cobblemon_contents.concept.tyranitar_veil.name": "Zoe",
  "factory.more_cobblemon_contents.concept.tyranitar_veil.description": "Bronzong chooses screens or Trick Room for Tyranitar while Weavile and Venusaur provide fast cleanup and sleep pressure.",
  "factory.more_cobblemon_contents.concept.cloyster_control.name": "Ian",
  "factory.more_cobblemon_contents.concept.cloyster_control.description": "Gardevoir controls speed while Slowking pivots and heals; Hawlucha adds immediate physical pressure to open Shell Smash for Cloyster.",
  "factory.more_cobblemon_contents.concept.serperior_special.name": "Kate",
  "factory.more_cobblemon_contents.concept.serperior_special.description": "Serperior snowballs with Leaf Storm while Armarouge uses Power Herb for immediate pressure; Quaquaval and Goodra cover both damage axes.",
  "factory.more_cobblemon_contents.concept.garchomp_redirection.name": "Evan",
  "factory.more_cobblemon_contents.concept.garchomp_redirection.description": "Togekiss redirects attacks, Aegislash creates defensive turns, and Rillaboom supplies Fake Out and priority for Garchomp.",
  "factory.more_cobblemon_contents.concept.volcarona_rain.name": "Ruby",
  "factory.more_cobblemon_contents.concept.volcarona_rain.description": "Pelipper and Barraskewda force rain answers while Ferrothorn absorbs their checks and creates a Quiver Dance window for Volcarona.",
  "factory.more_cobblemon_contents.concept.samurott_mixed.name": "Aaron",
  "factory.more_cobblemon_contents.concept.samurott_mixed.description": "Clefable redirects attacks, Conkeldurr turns status into power, and Porygon-Z breaks special walls to enable Samurott.",
  "factory.more_cobblemon_contents.concept.glimmora_hazard.name": "Lucy",
  "factory.more_cobblemon_contents.concept.glimmora_hazard.description": "Glimmora and Hippowdon establish hazards and forced switches while Greninja and Mimikyu provide fast breaking and priority cleanup.",
  "factory.more_cobblemon_contents.concept.latios_offense.name": "Henry",
  "factory.more_cobblemon_contents.concept.latios_offense.description": "Aegislash creates defensive turns while Weavile and Volcarona pressure Latios checks from both damage axes.",
  "factory.more_cobblemon_contents.concept.zapdos_pivot.name": "Anna",
  "factory.more_cobblemon_contents.concept.zapdos_pivot.description": "Garchomp supplies an Electric immunity, Scizor provides U-turn and priority, and Gastrodon completes the defensive pivot core for Zapdos.",
  "factory.more_cobblemon_contents.concept.articuno_balance.name": "Dylan",
  "factory.more_cobblemon_contents.concept.articuno_balance.description": "Articuno stabilizes the field with Tailwind and Roost while Dragonite, Metagross, and Meowscarada divide setup and fast cleanup duties.",
  "factory.more_cobblemon_contents.concept.regigigas_control.name": "Emily",
  "factory.more_cobblemon_contents.concept.regigigas_control.description": "Registeel uses paralysis and Stealth Rock to cover Slow Start while Samurott and Rillaboom bridge into late-game Regigigas pressure.",
