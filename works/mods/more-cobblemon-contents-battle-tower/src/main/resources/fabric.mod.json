{
  "schemaVersion": 1,
  "id": "more_cobblemon_contents_battle_tower",
  "version": "${version}",
  "name": "More Cobblemon Contents: Battle Tower",
  "description": "Challenge consecutive battles with your own Pokémon team. This MCC addon adds Battle Tower opponents, streak progression and records, with rewards and battle management provided through the MCC core.",
  "authors": [
    "jbro"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.mcc.internal.tower.BattleTowerContent"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.mcc.client.BattleTowerContentClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0",
    "more_cobblemon_contents": ">=0.1.0 <1.0.0"
  },
  "icon": "assets/more_cobblemon_contents_battle_tower/icon.png",
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/more-cobblemon-contents-battle-tower",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
  },
  "suggests": {
    "modmenu": "*"
  }
}
