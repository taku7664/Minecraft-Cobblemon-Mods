  "authors": ["Park_JH"],
  "license": "CC0-1.0",
  "icon": "assets/pokefusion/icon.png",
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/pokefusion",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "kr.parkjh.pokefusion.PokeFusionMod"
    ],
    "client": [
      "kr.parkjh.pokefusion.client.PokeFusionClient"
    ],
    "modmenu": [
      "kr.parkjh.pokefusion.client.PokeFusionModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
