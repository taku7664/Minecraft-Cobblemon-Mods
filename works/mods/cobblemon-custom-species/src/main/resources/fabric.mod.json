{
  "schemaVersion": 1,
  "id": "cobblemon_custom_species",
  "version": "${version}",
  "name": "Cobblemon Custom Species",
  "description": "Reloadable single-file overrides for Cobblemon species stats, abilities, and learnsets.",
  "authors": ["jbro"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.customspecies.CobblemonCustomSpecies"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0"
  }
}
