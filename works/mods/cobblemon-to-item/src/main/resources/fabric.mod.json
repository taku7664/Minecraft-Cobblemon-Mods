{
  "schemaVersion": 1,
  "id": "cobblemon_to_item",
  "version": "${version}",
  "name": "Cobblemon To Item",
  "description": "Move complete Pokemon between party storage and portable items; shared Pokemon tooltip API.",
  "authors": ["jbro"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [{"adapter": "kotlin", "value": "jbro.cobblemon.toitem.CobblemonToItem"}],
    "client": [{"adapter": "kotlin", "value": "jbro.cobblemon.toitem.client.ToItemClient"}],
    "modmenu": ["jbro.cobblemon.toitem.client.ToItemModMenu"]
  },
  "mixins": ["cobblemon_to_item.mixins.json"],
  "accessWidener": "cobblemon_to_item.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5", "fabric-api": "*", "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~1.21.1", "java": ">=21", "cobblemon": ">=1.8.1 <1.9.0"
  },
  "suggests": {"modmenu": "*"}
}
