{
  "schemaVersion": 1,
  "id": "cobblemon_npc",
  "version": "${version}",
  "name": "Cobblemon NPC",
  "description": "Place and edit talking NPCs in-game. Build branching dialogues, choices and command actions with a server-controlled dialogue editor.",
  "authors": [
    "jbro"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.npc.CobblemonNpc"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.npc.client.CobblemonNpcClient"
      }
    ],
    "modmenu": [
      "jbro.cobblemon.npc.client.NpcModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0"
  },
  "icon": "assets/cobblemon_npc/icon.png",
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/cobblemon-npc",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
  },
  "suggests": {
    "modmenu": "*",
    "better_cobblemon_battlecam": "*"
  }
}
