{
  "schemaVersion": 1,
  "id": "better_cobblemon_music",
  "version": "${version}",
  "name": "Better Cobblemon Music",
  "description": "Contextual field, battle and menu music for Cobblemon, with battle hit sounds, low-HP alerts and underwater audio effects. Customize playback and music mappings through Mod Menu. Client-side only; a compatible music resource pack is required for audio.",
  "authors": ["jbro"],
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/better-cobblemon-music",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
  },
  "license": "MIT",
  "icon": "assets/better_cobblemon_music/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "jbro.cobblemon.bettermusic.BetterCobblemonMusicClient"
    ],
    "modmenu": [
      "jbro.cobblemon.bettermusic.client.BetterMusicModMenu"
    ]
  },
  "mixins": [
    "better_cobblemon_music.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0"
  },
  "suggests": {
    "more_cobblemon_contents": "*",
    "modmenu": "*",
    "cloth-config": "*"
  }
}
