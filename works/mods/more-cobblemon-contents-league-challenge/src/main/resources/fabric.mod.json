    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0",
    "more_cobblemon_contents": ">=0.1.0 <1.0.0",
    "pokebadges": "*",
    "cobbled_level_control": ">=1.2.0 <1.3.0"
  },
  "icon": "assets/more_cobblemon_contents_league_challenge/icon.png",
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/more-cobblemon-contents-league-challenge",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
