        "value": "jbro.cobblemon.mcc.league.MoreCobblemonContentsLeagueChallenge"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.mcc.league.client.MoreCobblemonContentsLeagueChallengeClient"
      }
    ]
  },
  "depends": {
