{
  "schemaVersion": 1,
  "id": "cobblemon_ui",
  "version": "${version}",
  "name": "Cobblemon UI",
  "description": "Redesigned Cobblemon battle screens with keyboard controls, team and field information, move tooltips, dialogue, a scrollable battle history, and customizable themes.",
  "icon": "assets/cobblemon_ui/icon.png",
  "authors": [
    "jbro"
  ],
  "contributors": [
    "sveniik (retained code from early Extended Battle UI work)"
  ],
  "contact": {
    "sources": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/tree/main/works/mods/cobblemon-ui",
    "issues": "https://github.com/taku7664/Minecraft-Cobblemon-Mods/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.uikit.client.CobblemonUiKitClient"
      },
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.ui.extended.CobblemonUiClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "jbro.cobblemon.ui.extended.ModMenuIntegration"
      }
    ]
  },
  "mixins": [
    "cobblemon_ui.mixins.json"
  ],
  "accessWidener": "cobblemon_ui.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.12.0",
    "cobblemon": "=1.8.1"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
